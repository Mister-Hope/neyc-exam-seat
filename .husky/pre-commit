# ⚠️ 防呆闸门：真实名单（学生姓名 / 准考证号）绝不入库。
# 这些路径已在 .gitignore 里；这里再拦一道，防止 `git add -f` 或手工加入。
#
# 覆盖范围与 .gitignore 保持一致：
#   inputs/          真实名单原件
#   out/  tmp/       排场结果（plan.json / 工作簿里都含学生姓名）
#   docs/需求-*.md   本地临时保存的、含真实数据的需求原件
staged_sensitive=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^(inputs/|out/|tmp/)|^docs/需求-.*\.md$' || true)
if [ -n "$staged_sensitive" ]; then
  echo "❌ 拒绝提交：以下暂存文件含学生姓名 / 准考证号等个人敏感信息。" >&2
  echo "   这些路径已在 .gitignore 里，通常是被 git add -f 强加进来的。" >&2
  echo "   需要公开样例请先脱敏（保留班级 / 选科，姓名与准考证号随机生成）。" >&2
  echo "   被拦下的文件：" >&2
  echo "$staged_sensitive" >&2
  exit 1
fi

pnpm exec nano-staged
