{
  "name": "exam-seat",
  "version": "0.0.3",
  "private": true,
  "description": "排考场工具：核心算法包 + CLI + Web 应用 + AI Skill",
  "license": "LicenseRef-Proprietary-NonCommercial",
  "type": "module",
  "scripts": {
    "acceptance": "node examples/acceptance.mjs",
    "build": "pnpm -r --filter './packages/*' --filter '!./packages/desktop' build",
    "commit:verify": "node scripts/verifyCommit.ts",
    "desktop:build:mac": "pnpm --filter @exam-seat/desktop build:mac",
    "desktop:build:win": "pnpm --filter @exam-seat/desktop build:win",
    "exam-seat": "node packages/cli/bin/exam-seat.mjs",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "prepare": "husky",
    "smoke": "node examples/smoke.mjs",
    "test": "vitest run && pnpm --filter @exam-seat/desktop test",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter './packages/*' --filter '!./packages/desktop' typecheck",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:desktop && pnpm typecheck:scripts",
    "typecheck:desktop": "tsc --noEmit -p packages/desktop/tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "verify": "pnpm lint:check && pnpm typecheck && pnpm build && pnpm test && pnpm acceptance"
  },
  "devDependencies": {
    "@mr-hope/verify-commit-message": "0.1.1",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "nano-staged": "^1.0.2",
    "oxc-config-hope": "^0.3.15",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,mjs,ts,vue}": "oxlint --fix"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.11.1"
}
